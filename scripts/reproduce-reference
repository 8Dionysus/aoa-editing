#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPEC=""
BASELINE=""
OUTPUT=""

usage() {
  echo "Usage: scripts/reproduce-reference --spec FILE --baseline FILE --output NEW_DIR"
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --spec)
      SPEC="$2"
      shift 2
      ;;
    --baseline)
      BASELINE="$2"
      shift 2
      ;;
    --output)
      OUTPUT="$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "${SPEC}" || -z "${BASELINE}" || -z "${OUTPUT}" ]]; then
  usage >&2
  exit 2
fi
if [[ -e "${OUTPUT}" ]]; then
  echo "Output must be a new path: ${OUTPUT}" >&2
  exit 2
fi

"${ROOT}/scripts/aoa-editing" eval clean-rerun-v2 \
  --spec "${SPEC}" \
  --baseline "${BASELINE}" \
  --output "${OUTPUT}"

echo "Selected Reference v2 semantics reproduced independently: ${OUTPUT}"
