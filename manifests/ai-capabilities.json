{
  "schema_version": "1.0.0",
  "id": "aoa-editing-local-ai-capabilities",
  "baseline_requires_ai": false,
  "physical_model_paths_allowed": false,
  "filesystem_links_allowed": false,
  "output_authority_contract": "evidence-or-proposal-only",
  "declarations": [
    {
      "schema_version": "1.0.0",
      "capability_id": "speech.transcript",
      "alias": "local-ai://speech/transcript/default",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["media_path"],
        "properties": {
          "media_path": {"type": "string", "minLength": 1},
          "language": {"type": ["string", "null"]},
          "profile": {"type": "string", "enum": ["auto", "fast", "quality", "long", "command"]}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["segments"],
        "properties": {
          "text": {"type": "string"},
          "language": {"type": ["string", "null"]},
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "text"],
              "properties": {
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0},
                "text": {"type": "string"},
                "speaker": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "partial": {"type": "boolean"}
        },
        "additionalProperties": true
      },
      "required": false,
      "privacy_class": "local-media-sensitive",
      "authority_class": "evidence",
      "latency": {
        "service_class": "nearline",
        "target_milliseconds": 30000,
        "hard_timeout_seconds": 1800
      },
      "temporal_precision": "segment",
      "fallback": {
        "strategy_id": "localized-transcript-failure",
        "behavior": "localized-failure",
        "preserves_baseline": true,
        "description": "Persist a localized analysis.failure while silence and loudness evidence remain usable."
      },
      "failure_contract": {
        "localized": true,
        "sibling_evidence_survives": true,
        "retryable_codes": ["provider_missing", "provider_unavailable", "provider_stale", "provider_timeout"],
        "non_retryable_codes": ["privacy_denied", "version_mismatch", "malformed_response"]
      },
      "provenance_requirements": [
        "resolved_owner",
        "adapter_kind",
        "backend",
        "model_id",
        "model_revision",
        "model_hash_authority",
        "license_authority",
        "health_evidence",
        "privacy_decision",
        "fallback_status"
      ],
      "health_contract": {
        "probe_required": true,
        "maximum_age_seconds": 300,
        "expected_protocol_version": "aoa-local-ai-v1",
        "model_revision_required": true,
        "fail_closed": true
      }
    },
