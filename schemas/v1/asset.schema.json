{
  "$defs": {
    "FrameRate": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "title": "FrameRate",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "image",
        "video",
        "audio"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "MediaMetadata": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nominal_frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "video_time_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "video_frame_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Frame Count"
        },
        "variable_frame_rate": {
          "default": false,
          "title": "Variable Frame Rate",
          "type": "boolean"
        },
        "sample_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "channels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "format_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Name"
        },
        "video_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Codec"
        },
        "audio_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Codec"
        },
        "pixel_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Format"
        },
        "color_space": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Space"
        },
        "has_video": {
          "default": false,
          "title": "Has Video",
          "type": "boolean"
        },
        "has_audio": {
          "default": false,
          "title": "Has Audio",
          "type": "boolean"
        }
      },
      "title": "MediaMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "original_name": {
      "title": "Original Name",
      "type": "string"
    },
    "media_kind": {
      "$ref": "#/$defs/MediaKind"
    },
    "stored_path": {
      "title": "Stored Path",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "metadata": {
      "$ref": "#/$defs/MediaMetadata"
    }
  },
  "required": [
    "sha256",
    "original_name",
    "media_kind",
    "stored_path",
    "size_bytes",
    "metadata"
  ],
  "title": "Asset",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/aoa-editing/v1/asset.schema.json"
}
