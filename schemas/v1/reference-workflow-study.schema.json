{
  "$defs": {
    "FrameRate": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "title": "FrameRate",
      "type": "object"
    },
    "MediaMetadata": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nominal_frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "video_time_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "video_frame_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Frame Count"
        },
        "variable_frame_rate": {
          "default": false,
          "title": "Variable Frame Rate",
          "type": "boolean"
        },
        "sample_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "channels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "format_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Name"
        },
        "video_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Codec"
        },
        "audio_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Codec"
        },
        "pixel_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Format"
        },
        "color_space": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Space"
        },
        "has_video": {
          "default": false,
          "title": "Has Video",
          "type": "boolean"
        },
        "has_audio": {
          "default": false,
          "title": "Has Audio",
          "type": "boolean"
        }
      },
      "title": "MediaMetadata",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReferenceWorkflowCandidateRule": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_range_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Range Refs",
          "type": "array"
        },
        "authority": {
          "const": "candidate-observation",
          "default": "candidate-observation",
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence_range_refs"
      ],
      "title": "ReferenceWorkflowCandidateRule",
      "type": "object"
    },
    "ReferenceWorkflowRangeResult": {
      "additionalProperties": false,
      "properties": {
        "range_id": {
          "title": "Range Id",
          "type": "string"
        },
        "start_seconds": {
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "title": "End Seconds",
          "type": "number"
        },
        "content_class": {
          "enum": [
            "terminal",
            "ide",
            "browser-workflow",
            "workflow-ui",
            "diagram",
            "human",
            "title-card",
            "other"
          ],
          "title": "Content Class",
          "type": "string"
        },
        "decision": {
          "enum": [
            "include",
            "exclude"
          ],
          "title": "Decision",
          "type": "string"
        },
        "human_present": {
          "title": "Human Present",
          "type": "boolean"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "mean_frame_change": {
          "minimum": 0,
          "title": "Mean Frame Change",
          "type": "number"
        },
        "p90_frame_change": {
          "minimum": 0,
          "title": "P90 Frame Change",
          "type": "number"
        },
        "static_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Static Fraction",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "range_id",
        "start_seconds",
        "end_seconds",
        "content_class",
        "decision",
        "human_present",
        "sample_count",
        "mean_frame_change",
        "p90_frame_change",
        "static_fraction",
        "rationale"
      ],
      "title": "ReferenceWorkflowRangeResult",
      "type": "object"
    },
    "ReferenceWorkflowSourceResult": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "metadata": {
          "$ref": "#/$defs/MediaMetadata"
        },
        "ranges": {
          "items": {
            "$ref": "#/$defs/ReferenceWorkflowRangeResult"
          },
          "title": "Ranges",
          "type": "array"
        },
        "contact_sheet": {
          "title": "Contact Sheet",
          "type": "string"
        },
        "contact_sheet_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contact Sheet Sha256",
          "type": "string"
        },
        "source_path_persisted": {
          "const": false,
          "default": false,
          "title": "Source Path Persisted",
          "type": "boolean"
        }
      },
      "required": [
        "alias",
        "sha256",
        "size_bytes",
        "metadata",
        "ranges",
        "contact_sheet",
        "contact_sheet_sha256"
      ],
      "title": "ReferenceWorkflowSourceResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "readiness_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Readiness Revision",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ReferenceWorkflowSourceResult"
      },
      "title": "Sources",
      "type": "array"
    },
    "candidate_rules": {
      "items": {
        "$ref": "#/$defs/ReferenceWorkflowCandidateRule"
      },
      "title": "Candidate Rules",
      "type": "array"
    },
    "reference_media_copied": {
      "const": false,
      "default": false,
      "title": "Reference Media Copied",
      "type": "boolean"
    },
    "eligible_as_project_assets": {
      "const": false,
      "default": false,
      "title": "Eligible As Project Assets",
      "type": "boolean"
    },
    "eligible_as_render_inputs": {
      "const": false,
      "default": false,
      "title": "Eligible As Render Inputs",
      "type": "boolean"
    },
    "style_profile_written": {
      "const": false,
      "default": false,
      "title": "Style Profile Written",
      "type": "boolean"
    },
    "manual_review_complete": {
      "const": true,
      "default": true,
      "title": "Manual Review Complete",
      "type": "boolean"
    },
    "overall": {
      "const": "pass",
      "default": "pass",
      "title": "Overall",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "plan_id",
    "plan_sha256",
    "readiness_revision",
    "sources",
    "candidate_rules",
    "provenance"
  ],
  "title": "ReferenceWorkflowStudyReceipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/aoa-editing/v1/reference-workflow-study.schema.json"
}
