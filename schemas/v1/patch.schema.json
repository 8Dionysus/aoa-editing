{
  "$defs": {
    "PatchOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace",
            "test"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "PatchOperation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "base_version_id": {
      "title": "Base Version Id",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/PatchOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "inverse_operations": {
      "items": {
        "$ref": "#/$defs/PatchOperation"
      },
      "title": "Inverse Operations",
      "type": "array"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "base_version_id",
    "operations",
    "rationale"
  ],
  "title": "EditPatch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/aoa-editing/v1/patch.schema.json"
}
