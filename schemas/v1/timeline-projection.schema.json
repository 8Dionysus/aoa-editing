          "type": "boolean"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "effects": {
          "items": {
            "discriminator": {
              "mapping": {
                "audio": "#/$defs/AudioEffect",
                "blend": "#/$defs/BlendEffect",
                "blur": "#/$defs/BlurEffect",
                "color": "#/$defs/ColorEffect",
                "dissolve": "#/$defs/DissolveEffect",
                "glow": "#/$defs/GlowEffect",
                "mask": "#/$defs/MaskEffect",
                "speed": "#/$defs/SpeedEffect",
                "text": "#/$defs/TextEffect",
                "transform": "#/$defs/TransformEffect",
                "transform_v2": "#/$defs/TransformEffectV2"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TransformEffect"
              },
              {
                "$ref": "#/$defs/TransformEffectV2"
              },
              {
                "$ref": "#/$defs/ColorEffect"
              },
              {
                "$ref": "#/$defs/MaskEffect"
              },
              {
                "$ref": "#/$defs/AudioEffect"
              },
              {
                "$ref": "#/$defs/TextEffect"
              },
              {
                "$ref": "#/$defs/SpeedEffect"
              },
              {
                "$ref": "#/$defs/DissolveEffect"
              },
              {
                "$ref": "#/$defs/BlurEffect"
              },
              {
                "$ref": "#/$defs/GlowEffect"
              },
              {
                "$ref": "#/$defs/BlendEffect"
              }
            ]
          },
