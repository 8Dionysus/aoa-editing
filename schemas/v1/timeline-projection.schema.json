          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Brightness",
          "type": "number"
        },
        "contrast": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Contrast",
          "type": "number"
        },
        "saturation": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Saturation",
          "type": "number"
        },
        "gamma": {
