          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "decision_refs": {
          "items": {
            "type": "string"
          },
          "title": "Decision Refs",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "timeline_range"
      ],
      "title": "Clip",
      "type": "object"
    },
    "ColorEffect": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "color",
          "default": "color",
