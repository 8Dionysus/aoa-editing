{
  "$defs": {
    "AudioEffect": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "audio",
          "default": "audio",
          "title": "Type",
          "type": "string"
        },
        "gain_db": {
          "default": 0,
          "maximum": 24,
          "minimum": -96,
          "title": "Gain Db",
          "type": "number"
        },
        "gain_keyframes": {
          "items": {
            "$ref": "#/$defs/ScalarKeyframe"
          },
          "title": "Gain Keyframes",
          "type": "array"
        },
        "fade_in_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Fade In Frames",
          "type": "integer"
        },
        "fade_out_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Fade Out Frames",
          "type": "integer"
        },
        "normalize_lufs": {
          "anyOf": [
            {
              "maximum": -5,
              "minimum": -40,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalize Lufs"
        }
      },
      "title": "AudioEffect",
      "type": "object"
    },
    "BezierHandleV2": {
      "additionalProperties": false,
      "properties": {
        "time_offset_frames": {
          "title": "Time Offset Frames",
          "type": "number"
        },
        "value_offset": {
          "title": "Value Offset",
          "type": "number"
        }
      },
      "required": [
        "time_offset_frames",
        "value_offset"
      ],
      "title": "BezierHandleV2",
      "type": "object"
    },
    "BlendEffect": {
