          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Owner"
    },
    "adapter_kind": {
      "enum": [
        "abyss-stack-service",
        "abyss-machine-cli",
        "localhost-http",
        "disabled",
        "unavailable"
      ],
      "title": "Adapter Kind",
      "type": "string"
    },
    "backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "model_hash_authority": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Hash Authority"
    },
    "license_authority": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Authority"
    },
    "metadata_evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Evidence"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint"
    },
    "output_selector": {
      "items": {
        "type": "string"
      },
      "title": "Output Selector",
      "type": "array"
    },
    "partial_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "partial",
      "title": "Partial Field"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "health": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalProviderHealthBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_boundary": {
      "default": "local-host",
      "enum": [
        "local-host",
        "external"
      ],
      "title": "Data Boundary",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 120.0,
      "exclusiveMinimum": 0,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "alias",
    "state",
    "adapter_kind"
  ],
  "title": "LocalProviderBinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/aoa-editing/v1/local-provider-binding.schema.json"
}
