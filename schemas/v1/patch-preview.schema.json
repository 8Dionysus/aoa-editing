          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "PatchOperation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "base_version_id": {
      "title": "Base Version Id",
      "type": "string"
    },
    "natural_language_command": {
      "title": "Natural Language Command",
      "type": "string"
    },
    "patch": {
      "$ref": "#/$defs/EditPatch"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "requires_confirmation": {
      "const": true,
