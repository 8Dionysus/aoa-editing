        },
        "base_version_id": {
          "title": "Base Version Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/PatchOperation"
          },
          "title": "Operations",
          "type": "array"
        },
        "inverse_operations": {
          "items": {
            "$ref": "#/$defs/PatchOperation"
          },
          "title": "Inverse Operations",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "created_at": {
