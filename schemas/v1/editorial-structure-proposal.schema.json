{
  "$defs": {
    "EditorialStructureSection": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "hook",
            "setup",
            "development",
            "climax",
            "payoff",
            "conclusion",
            "cta"
          ],
          "title": "Role",
          "type": "string"
        },
        "frame_range": {
          "$ref": "#/$defs/FrameRange"
        },
        "shot_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Shot Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "role",
        "frame_range",
        "shot_ids",
        "summary",
        "confidence",
        "evidence_refs"
      ],
      "title": "EditorialStructureSection",
      "type": "object"
    },
    "FrameRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "duration"
      ],
      "title": "FrameRange",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RationaleItem": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "claim",
        "evidence_refs",
        "confidence"
      ],
      "title": "RationaleItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "anatomy_id": {
      "title": "Anatomy Id",
      "type": "string"
    },
    "anatomy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Anatomy Sha256",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/EditorialStructureSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "pacing_phases": {
      "items": {
        "type": "string"
      },
      "title": "Pacing Phases",
      "type": "array"
    },
    "shot_roles": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Shot Roles",
      "type": "object"
    },
    "likely_techniques": {
      "items": {
        "type": "string"
      },
      "title": "Likely Techniques",
      "type": "array"
    },
    "rationale": {
      "items": {
        "$ref": "#/$defs/RationaleItem"
      },
      "minItems": 1,
      "title": "Rationale",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "alternative_interpretations": {
      "items": {
        "type": "string"
      },
      "title": "Alternative Interpretations",
      "type": "array"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "timeline_mutated": {
      "const": false,
      "default": false,
      "title": "Timeline Mutated",
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "project_id",
    "asset_id",
    "anatomy_id",
    "anatomy_sha256",
    "sections",
    "shot_roles",
    "rationale",
    "evidence_refs",
    "provenance"
  ],
  "title": "EditorialStructureProposal",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/aoa-editing/v1/editorial-structure-proposal.schema.json"
}
