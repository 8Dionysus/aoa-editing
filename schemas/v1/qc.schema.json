{
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skip"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "measured": {
          "additionalProperties": true,
          "title": "Measured",
          "type": "object"
        }
      },
      "required": [
        "id",
        "status",
        "summary"
      ],
      "title": "CheckResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    },
    "render_path": {
      "title": "Render Path",
      "type": "string"
    },
    "render_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Sha256",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "overall": {
      "enum": [
        "pass",
        "fail",
        "warn"
      ],
      "title": "Overall",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "version_id",
    "render_path",
    "render_sha256",
    "checks",
    "overall"
  ],
  "title": "QCReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/aoa-editing/v1/qc.schema.json"
}
